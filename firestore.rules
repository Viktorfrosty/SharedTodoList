rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function isListMember(listId) {
      return signedIn()
        && exists(/databases/$(database)/documents/lists/$(listId))
        && get(/databases/$(database)/documents/lists/$(listId)).data.get('deletionInProgress', false) != true
        && get(/databases/$(database)/documents/lists/$(listId)).data.members
          .hasAny([request.auth.token.email.lower()]);
    }

    function isListOwner(listId) {
      return signedIn()
        && get(/databases/$(database)/documents/lists/$(listId)).data.ownerUid == request.auth.uid;
    }

    function validAssignment(listId, email) {
      return email == ''
        || get(/databases/$(database)/documents/lists/$(listId)).data.members
          .hasAny([email]);
    }

    function isMemberIdentityClaim(listId) {
      let email = request.auth.token.email.lower();
      let oldMemberUids = resource.data.get('memberUids', {});
      return isListMember(listId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
        && request.resource.data.memberUids is map
        && request.resource.data.memberUids.get(email, '') == request.auth.uid
        && request.resource.data.memberUids.diff(oldMemberUids)
          .affectedKeys().hasOnly([email]);
    }

    function isMemberLeaving(listId) {
      let email = request.auth.token.email.lower();
      let oldMemberUids = resource.data.get('memberUids', {});
      return isListMember(listId)
        && resource.data.ownerUid != request.auth.uid
        && resource.data.get('deletionInProgress', false) != true
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['members', 'memberUids'])
        && request.resource.data.members == resource.data.members.removeAll([email])
        && request.resource.data.memberUids is map
        && request.resource.data.memberUids.diff(oldMemberUids)
          .affectedKeys().hasOnly([email])
        && !(email in request.resource.data.memberUids);
    }

    function isOwnerRemovingMembers(listId) {
      let oldMemberUids = resource.data.get('memberUids', {});
      let removedEmails = resource.data.members.removeAll(request.resource.data.members);
      let expectedMemberUids = oldMemberUids.keys().removeAll(removedEmails);
      return isListOwner(listId)
        && resource.data.get('deletionInProgress', false) != true
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['members', 'memberUids'])
        && request.resource.data.members is list
        && request.resource.data.members.size() < resource.data.members.size()
        && resource.data.members.hasAll(request.resource.data.members)
        && request.resource.data.members.hasAny([request.auth.token.email.lower()])
        && request.resource.data.memberUids is map
        && request.resource.data.memberUids.diff(oldMemberUids)
          .affectedKeys().hasOnly(removedEmails)
        && request.resource.data.memberUids.keys().hasAll(expectedMemberUids)
        && expectedMemberUids.hasAll(request.resource.data.memberUids.keys());
    }

    function isOwnerTransfer(listId) {
      let email = request.auth.token.email.lower();
      let oldMemberUids = resource.data.get('memberUids', {});
      let newOwnerEmail = request.resource.data.ownerEmail;
      return isListOwner(listId)
        && resource.data.get('deletionInProgress', false) != true
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['ownerUid', 'ownerEmail', 'members', 'memberUids'])
        && newOwnerEmail is string
        && newOwnerEmail != email
        && newOwnerEmail in resource.data.members
        && request.resource.data.ownerUid == oldMemberUids.get(newOwnerEmail, '')
        && request.resource.data.members == resource.data.members.removeAll([email])
        && request.resource.data.memberUids is map
        && request.resource.data.memberUids.diff(oldMemberUids)
          .affectedKeys().hasOnly([email])
        && !(email in request.resource.data.memberUids);
    }

    function isDeletedListTombstone(listId) {
      return isListOwner(listId)
        && resource.data.get('deletionInProgress', false) == true
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['deleted', 'title', 'ownerUid', 'ownerEmail', 'members', 'memberUids'])
        && request.resource.data.get('deleted', false) == true
        && request.resource.data.title == 'Deleted list'
        && request.resource.data.ownerUid == ''
        && request.resource.data.ownerEmail == ''
        && request.resource.data.members == []
        && request.resource.data.memberUids == {};
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /lists/{listId} {
      // Keep this membership check aligned with the client's members array-contains query.
      // Firestore rules are not filters; a query is allowed only when its constraints prove
      // that every returned document passes this rule.
      allow read: if signedIn()
        && request.auth.token.email.lower() in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members is list
        && request.resource.data.members.hasAny([request.auth.token.email.lower()])
        && request.resource.data.memberUids is map
        && request.resource.data.memberUids.get(request.auth.token.email.lower(), '') == request.auth.uid
        && request.resource.data.get('deletionInProgress', false) == false
        && request.resource.data.get('deleted', false) == false
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 60;

      allow update: if isMemberIdentityClaim(listId)
        || isMemberLeaving(listId)
        || isOwnerRemovingMembers(listId)
        || isOwnerTransfer(listId)
        || isDeletedListTombstone(listId)
        || (isListOwner(listId)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.members.hasAny([request.auth.token.email.lower()])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 60
          && resource.data.get('deletionInProgress', false) != true
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['title', 'members', 'deletionInProgress'])
          && request.resource.data.get('deletionInProgress', false) is bool
          && (request.resource.data.get('deletionInProgress', false) == false
            || (request.resource.data.members is list
              && request.resource.data.members.size() == 1
              && request.resource.data.members.hasAny([request.auth.token.email.lower()]))));

      allow delete: if false;

      match /tasks/{taskId} {
        allow read: if isListMember(listId)
          || (isListOwner(listId)
            && get(/databases/$(database)/documents/lists/$(listId)).data
              .get('deletionInProgress', false) == true);

        allow create: if isListMember(listId)
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.listId == listId
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.isCompleted == false
          && validAssignment(listId, request.resource.data.assignedToEmail);

        allow update: if isListMember(listId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['title', 'isCompleted', 'assignedToEmail', 'createdByUid'])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.isCompleted is bool
          && (request.resource.data.createdByUid == resource.data.createdByUid
            || (resource.data.createdByUid == request.auth.uid
              && request.resource.data.createdByUid == ''))
          && (request.resource.data.assignedToEmail == resource.data.assignedToEmail
            || validAssignment(listId, request.resource.data.assignedToEmail));

        allow delete: if isListMember(listId)
          || (isListOwner(listId)
            && get(/databases/$(database)/documents/lists/$(listId)).data
              .get('deletionInProgress', false) == true);
      }
    }
  }
}
